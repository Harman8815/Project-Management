{
  "name": "server",
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --config nest/jest.config.js",
    "test:watch": "jest --config nest/jest.config.js --watch",
    "test:coverage": "jest --config nest/jest.config.js --coverage",
    "lint": "eslint nest/src --ext .ts",
    "lint:fix": "eslint nest/src --ext .ts --fix",
    "format": "prettier --write \"nest/src/**/*.ts\"",
    "format:check": "prettier --check \"nest/src/**/*.ts\"",
    "typecheck": "npx tsc --project nest/tsconfig.json --noEmit",
    "build": "rimraf nest/dist && npx tsc --project nest/tsconfig.json",
    "start": "npm run build && node nest/dist/main.js",
    "dev": "nest start --watch",
    "seed": "ts-node prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --skip-seed",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nestjs/cli": "^10.2.3",
    "@nestjs/testing": "^10.2.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.4.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.4",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.2.4",
    "@nestjs/mapped-types": "^2.0.1",
    "@nestjs/platform-express": "^10.2.4",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.18.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  }
}