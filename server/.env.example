# Backend environment variables
# Copy this file to .env and adjust as needed

# Server port (default: 8000)
PORT=8000

# Database connection string
# SQLite (local/dev): file:./dev.db
# PostgreSQL (production): postgresql://user:password@host:port/database
DATABASE_URL="file:./dev.db"

# Skip JWT authentication for local development.
# Set to true to disable the global JwtAuthGuard so the frontend can reach the API.
# Leave unset (false) in production to enforce authentication.
AUTH_DISABLED=true
