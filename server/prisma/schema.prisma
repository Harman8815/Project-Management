// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  userId            Int     @id @default(autoincrement())
  cognitoId         String  @unique
  username          String  @unique
  profilePictureUrl String?
  teamId            Int?

  authoredTasks     Task[]           @relation("TaskAuthor")
  assignedTasks     Task[]           @relation("TaskAssignee")
  taskAssignments   TaskAssignment[]
  attachments       Attachment[]
  comments          Comment[]
  team              Team?            @relation(fields: [teamId], references: [id])
  projectMemberships ProjectMembership[]
  invitedMembers    ProjectMembership[] @relation("InvitedBy")
  createdTemplates   ProjectTemplate[]
  taskWatchers       TaskWatcher[]
  taskHistoryChanges TaskHistory[]
  ownedMilestones    Milestone[]
  ownedSprints       Sprint[]
}

model Team {
  id                   Int           @id @default(autoincrement())
  teamName             String
  productOwnerUserId   Int?
  projectManagerUserId Int?
  projectTeams         ProjectTeam[]
  user                 User[]
}

model Project {
  id          Int      @id @default(autoincrement())
  key         String?  @unique
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  dueDate     DateTime?
  status      String   @default("PLANNED")
  priority    String   @default("MEDIUM")
  health      String   @default("ON_TRACK")
  objectives  String?
  archived    Boolean  @default(false)
  tasks       Task[]
  projectTeams ProjectTeam[]
  members     ProjectMembership[]
  milestones  Milestone[]
  sprints     Sprint[]
}

model ProjectTeam {
  id        Int     @id @default(autoincrement())
  teamId    Int
  projectId Int
  team      Team    @relation(fields: [teamId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])
}

model ProjectMembership {
  id         Int      @id @default(autoincrement())
  userId     Int
  projectId  Int
  role       String   @default("MEMBER")
  status     String   @default("ACTIVE")
  invitedById Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User    @relation(fields: [userId], references: [userId])
  project    Project @relation(fields: [projectId], references: [id])
  invitedBy  User?   @relation("InvitedBy", fields: [invitedById], references: [userId])
}

model ProjectTemplate {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  isDefault     Boolean  @default(false)
  projectConfig String?
  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User?    @relation(fields: [createdById], references: [userId])
}

model Task {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  status         String?
  priority       String?
  severity       String?
  type           String?   @default("TASK")
  tags           String?
  startDate      DateTime?
  dueDate        DateTime?
  points         Int?
  estimateHours  Int?
  actualHours    Int?
  acceptanceCriteria String?
  identifier     String?   @unique
  position       Int?
  projectId      Int
  authorUserId   Int
  assignedUserId Int?
  parentId       Int?
  milestoneId    Int?
  sprintId       Int?

  project         Project          @relation(fields: [projectId], references: [id])
  author          User             @relation("TaskAuthor", fields: [authorUserId], references: [userId])
  assignee        User?            @relation("TaskAssignee", fields: [assignedUserId], references: [userId])
  parent          Task?            @relation("TaskHierarchy", fields: [parentId], references: [id])
  children        Task[]           @relation("TaskHierarchy")
  taskAssignments TaskAssignment[]
  attachments     Attachment[]
  comments        Comment[]
  taskDependenciesAsBlocked TaskDependency[] @relation("BlockedTask")
  taskDependenciesAsBlocker TaskDependency[] @relation("BlockerTask")
  watchers        TaskWatcher[]
  history         TaskHistory[]
  milestone       Milestone?       @relation(fields: [milestoneId], references: [id])
  sprint          Sprint?          @relation("SprintTasks", fields: [sprintId], references: [id])
}

model Milestone {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  projectId    Int
  startDate    DateTime?
  dueDate      DateTime?
  status       String   @default("PLANNED")
  ownerId      Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id])
  owner        User?    @relation(fields: [ownerId], references: [userId])
  tasks        Task[]
}

model Sprint {
  id            Int      @id @default(autoincrement())
  name          String
  projectId     Int
  goal          String?
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("PLANNED")
  capacity      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id])
  sprintTasks   Task[]   @relation("SprintTasks")
  owner         User?    @relation(fields: [ownerId], references: [userId])
  ownerId       Int?
}

model TaskAssignment {
  id     Int @id @default(autoincrement())
  userId Int
  taskId Int

  user User @relation(fields: [userId], references: [userId])
  task Task @relation(fields: [taskId], references: [id])
}

model TaskDependency {
  id          Int @id @default(autoincrement())
  taskId      Int
  blockedById Int

  task        Task @relation("BlockedTask", fields: [taskId], references: [id])
  blockedBy   Task @relation("BlockerTask", fields: [blockedById], references: [id])
}

model TaskWatcher {
  id     Int @id @default(autoincrement())
  taskId Int
  userId Int
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [userId])
}

model TaskHistory {
  id          Int      @id @default(autoincrement())
  taskId      Int
  field       String
  oldValue    String?
  newValue    String?
  changedById Int?
  createdAt   DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  changedBy User? @relation(fields: [changedById], references: [userId])
}

model Attachment {
  id           Int     @id @default(autoincrement())
  fileURL      String
  fileName     String?
  taskId       Int
  uploadedById Int

  task       Task @relation(fields: [taskId], references: [id])
  uploadedBy User @relation(fields: [uploadedById], references: [userId])
}

model Comment {
  id     Int    @id @default(autoincrement())
  text   String
  taskId Int
  userId Int

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [userId])
}
